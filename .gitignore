# Python
.venv/
__pycache__/
*.pyc

# Node
node_modules/
web/dist/
*.tsbuildinfo

# Downloaded NASA/USGS source data (1.1 GB). pipeline/build_globe.py downloads it again.
data/raw/globe/
# Intermediate and audit outputs, rebuilt by the pipeline
data/processed/
data/audit/

# "Land here" sites, built on demand by pipeline/site_server.py
web/public/sites/

# Editor and OS files
.DS_Store
.vscode/
.idea/
*.log
red-atlas-share.zip

# Climate layers. Temperature and wind derive from OpenMARS (CC BY-NC-ND 4.0: no redistribution of derivatives),
# so each computer rebuilds them: .venv/bin/python pipeline/build_climate.py. Dust (CC BY-SA 3.0) is committed,
# with climate_public.json (dust only), which the online version reads.
data/raw/climate/
web/public/globe/climate.json
web/public/globe/temp*.i16
web/public/globe/temp.png
web/public/globe/wind*
